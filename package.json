{
  "name": "chattahoochee",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Tauri desktop messenger for Skype for Business and Teamwire.",
  "license": "MIT",
  "engines": { "node": ">=22.12.0" },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1421 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts packages/teamwire-sdk/test/*.test.ts",
    "test:coverage": "node scripts/coverage.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@openhoo/teamwire-sdk": "0.1.0",
    "@shadcn/react": "0.3.1",
    "@tauri-apps/api": "2.11.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.68.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "skypeforhoo": "https://github.com/openhoo/skypeforhoo/releases/download/v0.2.0/skypeforhoo-0.2.0.tgz",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
